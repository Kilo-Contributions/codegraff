{
  "graff": {
    "cmd": ["graff", "-p", "{prompt}", "--model", "{model}", "--yolo"],
    "answer": "stdout",
    "usage": "graff-stderr",
    "capabilities": ["output-schema"],
    "schema_args": ["--output-schema", "{schema}"],
    "env": {"GRAFF_POST_DEADLINE_SECS": "90"},
    "default_model": "grok-4.6"
  },
  "graff-full": {
    "cmd": ["graff", "-p", "{prompt}", "--model", "{model}", "--yolo", "--no-lean"],
    "answer": "stdout",
    "usage": "graff-stderr",
    "capabilities": ["output-schema"],
    "schema_args": ["--output-schema", "{schema}"],
    "default_model": "grok-4.6"
  },
  "graff-dev": {
    "cmd": ["{repo}/zig-out/bin/graff", "-p", "{prompt}", "--model", "{model}", "--yolo"],
    "answer": "stdout",
    "usage": "graff-stderr",
    "capabilities": ["output-schema"],
    "schema_args": ["--output-schema", "{schema}"],
    "env": {"GRAFF_POST_DEADLINE_SECS": "90"},
    "default_model": "grok-4.6"
  },
  "graff-dev-repl": {
    "cmd": ["{repo}/zig-out/bin/graff", "repl", "--model", "{model}", "--yolo"],
    "stdin": "{prompt}\n",
    "answer": "stdout",
    "usage": "graff-stderr",
    "capabilities": [],
    "env": {"GRAFF_POST_DEADLINE_SECS": "90"},
    "default_model": "grok-4.6",
    "note": "scripted `graff repl` (non-TTY). Same learn-auto path as -p. TTY `graff repl` is the TUI."
  },
  "graff-dev-noxsearch": {
    "cmd": ["{repo}/zig-out/bin/graff", "-p", "{prompt}", "--model", "{model}", "--yolo"],
    "answer": "stdout",
    "usage": "graff-stderr",
    "capabilities": ["output-schema"],
    "schema_args": ["--output-schema", "{schema}"],
    "env": {"GRAFF_XAI_X_SEARCH": "0", "GRAFF_POST_DEADLINE_SECS": "90"},
    "default_model": "grok-4.6",
    "note": "hillclimb candidate: ADR 0031 opt-out. Hosted x_search off; catalog unchanged."
  },
  "graff-dev-rlm": {
    "cmd": ["{repo}/zig-out/bin/graff", "-p", "{prompt}", "--model", "{model}", "--yolo", "--rlm"],
    "answer": "stdout",
    "usage": "graff-stderr",
    "capabilities": ["output-schema"],
    "schema_args": ["--output-schema", "{schema}"],
    "env": {"GRAFF_POST_DEADLINE_SECS": "90"},
    "default_model": "grok-4.6",
    "note": "explicit --rlm (same as graff-dev after RLM became the default)"
  },
  "graff-dev-nolean": {
    "cmd": ["{repo}/zig-out/bin/graff", "-p", "{prompt}", "--model", "{model}", "--yolo", "--no-lean"],
    "answer": "stdout",
    "usage": "graff-stderr",
    "capabilities": ["output-schema"],
    "schema_args": ["--output-schema", "{schema}"],
    "env": {"GRAFF_POST_DEADLINE_SECS": "90"},
    "default_model": "grok-4.6",
    "note": "full harness for the MCP bench: --no-lean (complete catalog). Lean is a different prefix and is not comparable."
  },
  "graff-dev-rlm-struct": {
    "cmd": ["{repo}/zig-out/bin/graff", "-p", "{prompt}", "--model", "{model}", "--yolo", "--no-lean"],
    "answer": "stdout",
    "usage": "graff-stderr",
    "capabilities": ["output-schema"],
    "schema_args": ["--output-schema", "{schema}"],
    "env": {"GRAFF_POST_DEADLINE_SECS": "90", "GRAFF_RLM_MCP": "0"},
    "default_model": "grok-4.6",
    "note": "default rlm but MCP stays structured-only (today's gap / variant B)"
  },
  "graff-dev-old-nolean": {
    "cmd": ["{repo}/zig-out/bin/graff", "-p", "{prompt}", "--model", "{model}", "--yolo", "--old", "--no-lean"],
    "answer": "stdout",
    "usage": "graff-stderr",
    "capabilities": ["output-schema"],
    "schema_args": ["--output-schema", "{schema}"],
    "env": {"GRAFF_POST_DEADLINE_SECS": "90"},
    "default_model": "grok-4.6",
    "note": "--old structured MCP only + --no-lean so load_tool_schemas is visible"
  },
  "graff-dev-old": {
    "cmd": ["{repo}/zig-out/bin/graff", "-p", "{prompt}", "--model", "{model}", "--yolo", "--old"],
    "answer": "stdout",
    "usage": "graff-stderr",
    "capabilities": ["output-schema"],
    "schema_args": ["--output-schema", "{schema}"],
    "env": {"GRAFF_POST_DEADLINE_SECS": "90"},
    "default_model": "grok-4.6",
    "note": "pre-rlm structured-only catalog (--old)"
  },
  "grok": {
    "cmd": ["grok", "-p", "{prompt}", "-m", "{model}", "--always-approve", "--output-format", "streaming-messages-json"],
    "answer": "grok-stream",
    "usage": "grok-stream",
    "capabilities": [],
    "default_model": "grok-4.6"
  },
  "claude": {
    "cmd": ["claude", "-p", "{prompt}", "--model", "{model}", "--dangerously-skip-permissions"],
    "answer": "stdout",
    "usage": null,
    "capabilities": [],
    "default_model": "claude-sonnet-5"
  },
  "dsh": {
    "cmd": ["dsh", "--profile", "headless", "--patch", "{repo}/graff-evals/dsh-luna.yml", "{prompt}"],
    "answer": "stdout",
    "usage": null,
    "capabilities": [],
    "env": {"DSH_PERMISSION_MODE": "danger-full-access"},
    "default_model": "gpt-5.6-luna",
    "note": "no --model flag; the model is pinned by the dsh-luna.yml patch layer"
  },
  "pi": {
    "cmd": ["pi", "-p", "--mode", "json", "--provider", "openai", "--model", "{model}", "--no-session", "{prompt}"],
    "answer": "pi-json",
    "usage": "pi-json",
    "capabilities": [],
    "default_model": "gpt-5.6-luna"
  },
  "dsh-deepseek": {
    "cmd": ["dsh", "--profile", "headless", "{prompt}"],
    "answer": "stdout",
    "usage": null,
    "capabilities": [],
    "env": {"DSH_PERMISSION_MODE": "danger-full-access"},
    "default_model": "deepseek-v4-flash",
    "note": "dsh's native default route (deepseek-official/deepseek-v4-flash); no patch layer"
  },
  "pi-deepseek": {
    "cmd": ["pi", "-p", "--mode", "json", "--provider", "deepseek", "--model", "{model}", "--no-session", "{prompt}"],
    "answer": "pi-json",
    "usage": "pi-json",
    "capabilities": [],
    "default_model": "deepseek-v4-flash"
  },
  "pi-codegraff": {
    "cmd": ["pi", "-p", "--mode", "json", "--provider", "codegraff", "--model", "{model}", "--no-session", "{prompt}"],
    "answer": "pi-json",
    "usage": "pi-json",
    "capabilities": [],
    "default_model": "gemini-3.7-flash",
    "note": "uses ~/.pi/agent/models.json provider codegraff → gateway.codegraff.com; Gemini tool loops need the codegraff-gemini-echo extension"
  },
  "opencode-codegraff": {
    "cmd": ["{repo}/graff-evals/opencode-codegraff.sh", "-m", "codegraff/{model}", "--dir", "{sandbox}", "{prompt}"],
    "answer": "opencode-json",
    "usage": "opencode-json",
    "capabilities": [],
    "default_model": "deepseek-v4-flash",
    "note": "OpenCode on the Codegraff gateway (same CODEGRAFF_API_KEY seat as graff-dev / pi-codegraff). Wrapper needs `opencode` on PATH (~/.opencode/bin)."
  },
  "pi-xai": {
    "cmd": ["{repo}/graff-evals/pi-xai.sh", "-p", "--mode", "json", "--provider", "xai", "--model", "{model}", "--no-session", "{prompt}"],
    "answer": "pi-json",
    "usage": "pi-json",
    "capabilities": [],
    "default_model": "grok-4.6",
    "note": "same SuperGrok seat as graff-dev. Wrapper reads graff-oauth.json into XAI_API_KEY. `pi` must be on PATH."
  },
  "opencode": {
    "cmd": ["{repo}/graff-evals/opencode-xai.sh", "--dir", "{sandbox}", "-m", "{model}", "{prompt}"],
    "answer": "opencode-json",
    "usage": "opencode-json",
    "capabilities": [],
    "model_prefix": "xai",
    "default_model": "xai/grok-4.6",
    "note": "OpenCode 1.18 headless on SuperGrok. Wrapper maps graff-oauth.json → XAI_API_KEY and injects X-XAI-Token-Auth via opencode-xai.json. --dir is the eval sandbox. --pure skips plugins."
  },
  "exo": {
    "cmd": ["{repo}/graff-evals/exo-xai.sh", "--model", "{model}", "{prompt}"],
    "answer": "stdout",
    "usage": "graff-stderr",
    "capabilities": [],
    "default_model": "grok-4.6",
    "note": "exoharness/exo (https://github.com/exoharness/exo) on SuperGrok via local-process (no Docker). Wrapper refreshes graff-oauth, injects X-XAI-Token-Auth through xai-header-proxy.py, mounts the eval sandbox at /home/exo/workspace. Needs `exo` on PATH or EXO_BIN / /tmp/exo/target/release/exo."
  },
  "opencode-zen": {
    "cmd": ["opencode", "run", "--format", "json", "--auto", "--pure", "--dir", "{sandbox}", "-m", "{model}", "{prompt}"],
    "answer": "opencode-json",
    "usage": "opencode-json",
    "capabilities": [],
    "default_model": "opencode/big-pickle",
    "note": "OpenCode native Zen free model — NOT grok-4.6. Plot on the mixed-model chart only."
  },
  "dsh-grok": {
    "cmd": ["dsh", "--profile", "headless", "--patch", "{repo}/graff-evals/dsh-grok.yml", "{prompt}"],
    "answer": "stdout",
    "usage": null,
    "capabilities": [],
    "env": {"DSH_PERMISSION_MODE": "danger-full-access"},
    "default_model": "grok-4.6",
    "note": "Same-model attempt. dsh 0.1.1-rc.2 pi-ai catalog has no grok-4.6 (only grok-4.5 / 4.3 / grok-build-0.1). Expect UNKNOWN_MODEL. Use dsh-xai for a live dsh point."
  },
  "dsh-xai": {
    "cmd": ["dsh", "--profile", "headless", "--patch", "{repo}/graff-evals/dsh-xai.yml", "{prompt}"],
    "answer": "stdout",
    "usage": null,
    "capabilities": [],
    "env": {"DSH_PERMISSION_MODE": "danger-full-access"},
    "default_model": "grok-4.5",
    "note": "deepseek-harness on grok-4.5 (nearest xAI id in its catalog). NOT grok-4.6. Mixed-model chart only. Needs Node >=22.15 (zstd). SuperGrok OAuth → XAI_API_KEY via attach-dsh-xai-oauth.py (local; see dsh-local-oauth.md). No usage footer."
  },
  "gemini-cli": {
    "cmd": ["{repo}/graff-evals/gemini-cli.sh", "-p", "{prompt}", "-m", "{model}", "-y", "--skip-trust", "-o", "json", "--allowed-mcp-server-names", "none"],
    "answer": "gemini-json",
    "usage": "gemini-json",
    "capabilities": [],
    "default_model": "gemini-3.5-flash",
    "note": "Official Google Gemini CLI (@google/gemini-cli) driven with GEMINI_API_KEY"
  },
  "pi-dev": {
    "cmd": ["pi", "-p", "--mode", "json", "--provider", "codegraff", "--model", "{model}", "--no-session", "{prompt}"],
    "answer": "pi-json",
    "usage": "pi-json",
    "capabilities": [],
    "default_model": "gemini-3.8-flash",
    "note": "Pi coding agent (pi.dev) on Codegraff gateway"
  },
  "graff-dev-completion": {
    "cmd": [
      "{repo}/zig-out/bin/graff",
      "-p",
      "{prompt}",
      "--model",
      "{model}",
      "--yolo",
      "--no-lean",
      "--no-telemetry",
      "--no-subagent-tier"
    ],
    "answer": "stdout",
    "usage": "graff-stderr",
    "capabilities": [],
    "env": {
      "GRAFF_FLEET": "off",
      "GRAFF_LEARN_AUTO": "off",
      "GRAFF_NO_TELEMETRY": "1",
      "GRAFF_MCP_CONFIG": "{repo}/graff-evals/live/graff-621/empty-mcp.json"
    },
    "default_model": "grok-4.6"
  },
  "fx-completion": {
    "cmd": ["{repo}/graff-evals/fx-completion.py", "{model}", "{prompt}"],
    "answer": "stdout",
    "usage": null,
    "capabilities": [],
    "env": {"FX_MAX_AGENT_STEPS": "0"},
    "default_model": "grok-4.6"
  },
  "graff-dev-g6-followthrough": {
    "cmd": ["{repo}/zig-out/bin/graff", "-p", "{prompt}", "--model", "{model}", "--yolo", "--append-system-prompt",
            "Infer the user's intent and task scope from the instructions and prior conversation. Bias towards action and carry the intended task to completion. When the user asks for new work or a fix, persist until the goal is complete, including read-only actions, isolated worktrees and draft PRs, unless a step is clearly destructive or irreversible. Treat \"can you\", \"I want to\" and \"help me\" as instructions to do the work, not to describe it. Before asking a clarifying question, finish the work that is already authorized so the user approves a concrete, reviewable result."],
    "answer": "stdout",
    "usage": "graff-stderr",
    "capabilities": ["output-schema"],
    "schema_args": ["--output-schema", "{schema}"],
    "env": {"GRAFF_POST_DEADLINE_SECS": "90"},
    "default_model": "gpt-6-sol",
    "note": "GPT-6 prompting guide candidate (g6-followthrough); judged by hillclimb.py round on held-out tasks before any prompt change ships (ADR 0214)"
  },
  "graff-dev-g6-skill-precedence": {
    "cmd": ["{repo}/zig-out/bin/graff", "-p", "{prompt}", "--model", "{model}", "--yolo", "--append-system-prompt",
            "The user's instructions take precedence over guidelines in a skill or instruction file. If a skill causes you to pause, ask for confirmation, or leave work unfinished, name the file, quote the instruction, and say how it applies."],
    "answer": "stdout",
    "usage": "graff-stderr",
    "capabilities": ["output-schema"],
    "schema_args": ["--output-schema", "{schema}"],
    "env": {"GRAFF_POST_DEADLINE_SECS": "90"},
    "default_model": "gpt-6-sol",
    "note": "GPT-6 prompting guide candidate (g6-skill-precedence); judged by hillclimb.py round on held-out tasks before any prompt change ships (ADR 0214)"
  },
  "graff-dev-g6-test-calibration": {
    "cmd": ["{repo}/zig-out/bin/graff", "-p", "{prompt}", "--model", "{model}", "--yolo", "--append-system-prompt",
            "Do not write tests for reversible, low-impact changes that mirror the implementation. Run the tests and checks the change needs; broaden or repeat them only when new changes, failures or open concerns justify it."],
    "answer": "stdout",
    "usage": "graff-stderr",
    "capabilities": ["output-schema"],
    "schema_args": ["--output-schema", "{schema}"],
    "env": {"GRAFF_POST_DEADLINE_SECS": "90"},
    "default_model": "gpt-6-sol",
    "note": "GPT-6 prompting guide candidate (g6-test-calibration); judged by hillclimb.py round on held-out tasks before any prompt change ships (ADR 0214)"
  },
  "graff-dev-g6-plain-prose": {
    "cmd": ["{repo}/zig-out/bin/graff", "-p", "{prompt}", "--model", "{model}", "--yolo", "--append-system-prompt",
            "Default to clear, concise paragraphs, each developing one idea. Use lists only for parallel, sequential or comparable information. State the main point early, in plain language with precise verbs, and avoid stock phrases and concluding summaries."],
    "answer": "stdout",
    "usage": "graff-stderr",
    "capabilities": ["output-schema"],
    "schema_args": ["--output-schema", "{schema}"],
    "env": {"GRAFF_POST_DEADLINE_SECS": "90"},
    "default_model": "gpt-6-sol",
    "note": "GPT-6 prompting guide candidate (g6-plain-prose); judged by hillclimb.py round on held-out tasks before any prompt change ships (ADR 0214)"
  },
  "graff-codex": {
    "cmd": ["{repo}/zig-out/bin/graff", "-p", "{prompt}", "--model", "{model}", "--yolo", "--no-lean"],
    "answer": "stdout",
    "usage": "graff-stderr",
    "model_prefix": "codex",
    "default_model": "gpt-6.1-sol"
  },
  "graff-codex-repl": {
    "cmd": ["{repo}/zig-out/bin/graff", "repl", "--model", "{model}", "--yolo"],
    "stdin": "{prompt}\n",
    "answer": "stdout",
    "usage": "graff-stderr",
    "env": {"GRAFF_POST_DEADLINE_SECS": "90"},
    "model_prefix": "codex",
    "default_model": "gpt-6.1-sol",
    "note": "scripted graff repl over the Codex WebSocket: the transport the Codex app server uses"
  },
  "graff-hc-champ": {
    "cmd": ["{repo}/zig-out/bin/graff", "repl", "--model", "{model}", "--yolo"],
    "stdin": "{prompt}\n",
    "answer": "stdout",
    "usage": "graff-stderr",
    "env": {"GRAFF_POST_DEADLINE_SECS": "90"},
    "model_prefix": "codex",
    "default_model": "gpt-6.1-sol",
    "note": "hill-climb arm vs the Codex app server; GRAFF_HC names the switches"
  },
  "graff-hc-habits": {
    "cmd": ["{repo}/zig-out/bin/graff", "repl", "--model", "{model}", "--yolo"],
    "stdin": "{prompt}\n",
    "answer": "stdout",
    "usage": "graff-stderr",
    "env": {"GRAFF_POST_DEADLINE_SECS": "90", "GRAFF_HC": "issue-soft,headsup-short,new-file-no-read"},
    "model_prefix": "codex",
    "default_model": "gpt-6.1-sol",
    "note": "hill-climb arm vs the Codex app server; GRAFF_HC names the switches"
  },
  "graff-hc-fold": {
    "cmd": ["{repo}/zig-out/bin/graff", "repl", "--model", "{model}", "--yolo"],
    "stdin": "{prompt}\n",
    "answer": "stdout",
    "usage": "graff-stderr",
    "env": {"GRAFF_POST_DEADLINE_SECS": "90", "GRAFF_HC": "fold-more"},
    "model_prefix": "codex",
    "default_model": "gpt-6.1-sol",
    "note": "hill-climb arm vs the Codex app server; GRAFF_HC names the switches"
  },
  "graff-hc-userkey": {
    "cmd": ["{repo}/zig-out/bin/graff", "repl", "--model", "{model}", "--yolo"],
    "stdin": "{prompt}\n",
    "answer": "stdout",
    "usage": "graff-stderr",
    "env": {"GRAFF_POST_DEADLINE_SECS": "90", "GRAFF_HC": "user-key"},
    "model_prefix": "codex",
    "default_model": "gpt-6.1-sol",
    "note": "hill-climb arm vs the Codex app server; GRAFF_HC names the switches"
  },
  "graff-hc-userkey-habits": {
    "cmd": ["{repo}/zig-out/bin/graff", "repl", "--model", "{model}", "--yolo"],
    "stdin": "{prompt}\n",
    "answer": "stdout",
    "usage": "graff-stderr",
    "env": {"GRAFF_POST_DEADLINE_SECS": "90", "GRAFF_HC": "user-key,issue-soft,headsup-short,new-file-no-read"},
    "model_prefix": "codex",
    "default_model": "gpt-6.1-sol",
    "note": "hill-climb arm vs the Codex app server; GRAFF_HC names the switches"
  },
  "graff-hc-userkey-fold": {
    "cmd": ["{repo}/zig-out/bin/graff", "repl", "--model", "{model}", "--yolo"],
    "stdin": "{prompt}\n",
    "answer": "stdout",
    "usage": "graff-stderr",
    "env": {"GRAFF_POST_DEADLINE_SECS": "90", "GRAFF_HC": "user-key,fold-more"},
    "model_prefix": "codex",
    "default_model": "gpt-6.1-sol",
    "note": "hill-climb arm vs the Codex app server; GRAFF_HC names the switches"
  },
  "codex-app-server": {
    "cmd": ["python3", "{repo}/graff-evals/codex_app_server.py", "{model}", "{prompt}"],
    "answer": "stdout",
    "usage": "graff-stderr",
    "default_model": "gpt-6.1-sol"
  }
}
